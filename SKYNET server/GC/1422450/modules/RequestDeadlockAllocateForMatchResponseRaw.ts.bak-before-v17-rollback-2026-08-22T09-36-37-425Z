/*
 * === SKYNET_SERVER_LOBBY_101_INGAME_V17_HELPERS ===
 *
 * Minimal manual CSOCitadelLobby encoder used ONLY for the
 * server-side SO update from Assign(0) -> InGame(1).
 *
 * Official fields encoded:
 *
 *   1  uint64 lobby_id
 *   2  uint64 match_id
 *   3  match_mode              PrivateLobby = 2
 *   4  game_mode               Normal = 1
 *   5  compatibility_version   6677
 *   7  fixed64 server_steam_id
 *   8  server_state            InGame = 1
 *   13 server_version          6677
 *   14 safe_to_abandon         true
 *   16 game_mode_version       2
 *
 * IMPORTANT:
 * No BigInt(number) calls.
 */

function skynetV17PushVarintNumber(
    out: number[],
    input: number
): void {
    let value =
        input;

    while (
        value >= 128
    ) {
        out.push(
            (value & 127) | 128
        );

        value =
            Math.floor(
                value / 128
            );
    }

    out.push(
        value
    );
}

function skynetV17PushVarintBig(
    out: number[],
    input: bigint
): void {
    let value =
        input;

    while (
        value >= 128n
    ) {
        out.push(
            Number(
                (value & 127n) |
                128n
            )
        );

        value =
            value >> 7n;
    }

    out.push(
        Number(
            value
        )
    );
}

function skynetV17PushKey(
    out: number[],
    fieldNumber: number,
    wireType: number
): void {
    skynetV17PushVarintNumber(
        out,
        fieldNumber * 8 + wireType
    );
}

function skynetV17PushUInt32(
    out: number[],
    fieldNumber: number,
    value: number
): void {
    skynetV17PushKey(
        out,
        fieldNumber,
        0
    );

    skynetV17PushVarintNumber(
        out,
        value
    );
}

function skynetV17PushUInt64(
    out: number[],
    fieldNumber: number,
    value: bigint
): void {
    skynetV17PushKey(
        out,
        fieldNumber,
        0
    );

    skynetV17PushVarintBig(
        out,
        value
    );
}

function skynetV17PushFixed64(
    out: number[],
    fieldNumber: number,
    input: bigint
): void {
    skynetV17PushKey(
        out,
        fieldNumber,
        1
    );

    let value =
        input;

    let i = 0;

    while (
        i < 8
    ) {
        out.push(
            Number(
                value & 255n
            )
        );

        value =
            value >> 8n;

        i =
            i + 1;
    }
}

function skynetV17EncodeServerLobbyInGame(
    lobbyId: bigint,
    serverSteamId: bigint
): Uint8Array {
    const out: number[] = [];

    // field 1: lobby_id
    skynetV17PushUInt64(
        out,
        1,
        lobbyId
    );

    // field 2: match_id
    skynetV17PushUInt64(
        out,
        2,
        lobbyId
    );

    // field 3: ECitadelMatchMode PrivateLobby
    skynetV17PushUInt32(
        out,
        3,
        2
    );

    // field 4: ECitadelGameMode Normal
    skynetV17PushUInt32(
        out,
        4,
        1
    );

    // field 5: compatibility_version
    skynetV17PushUInt32(
        out,
        5,
        6677
    );

    // field 7: server_steam_id (fixed64)
    skynetV17PushFixed64(
        out,
        7,
        serverSteamId
    );

    // field 8: ELobbyServerState InGame
    skynetV17PushUInt32(
        out,
        8,
        1
    );

    // field 13: server_version
    skynetV17PushUInt32(
        out,
        13,
        6677
    );

    // field 14: safe_to_abandon
    skynetV17PushUInt32(
        out,
        14,
        1
    );

    // field 16: game_mode_version
    skynetV17PushUInt32(
        out,
        16,
        2
    );

    return new Uint8Array(
        out
    );
}

