const SKYNET_SERVER_COMMON_LOBBY_SO_TYPE =
    101;

function sky101EncodeServerCommonLobby(
    party: any,
    lobbyId: bigint,
    serverSteamId: bigint
): number[] {
    const output: number[] =
        [];

    const matchMode =
        sky102Number(
            party.match_mode ??
            party.matchMode,
            2
        );

    const gameMode =
        sky102Number(
            party.game_mode ??
            party.gameMode,
            1
        );

    /*
     * CSOCitadelLobby:
     *
     *  1 uint64  lobby_id
     *  2 uint64  match_id
     *  3 enum    match_mode
     *  4 enum    game_mode
     *  5 uint32  compatibility_version
     *  7 fixed64 server_steam_id
     *  8 enum    server_state
     * 10 uint32  udp_connect_port
     * 13 uint32  server_version
     */

    sky102UInt64(
        output,
        1,
        lobbyId
    );

    /*
     * Same ID already sent to this dedicated through 10021.
     */
    sky102UInt64(
        output,
        2,
        lobbyId
    );

    sky102UInt(
        output,
        3,
        matchMode
    );

    sky102UInt(
        output,
        4,
        gameMode
    );

    sky102UInt(
        output,
        5,
        6677
    );

    sky102Fixed64(
        output,
        7,
        serverSteamId
    );

    /*
     * Assign.
     */
    sky102UInt(
        output,
        8,
        0
    );

    sky102UInt(
        output,
        10,
        27125
    );

    sky102UInt(
        output,
        13,
        6677
    );

    log(
        "[101-GS] ========================================"
    );

    log(
        "[101-GS] build CSOCitadelLobby type_id=101"
    );

    log(
        "[101-GS] lobby_id=" +
        lobbyId
    );

    log(
        "[101-GS] match_id=" +
        lobbyId
    );

    log(
        "[101-GS] match_mode=" +
        matchMode
    );

    log(
        "[101-GS] game_mode=" +
        gameMode
    );

    log(
        "[101-GS] server_steam_id=" +
        serverSteamId
    );

    log(
        "[101-GS] server_state=0"
    );

    log(
        "[101-GS] bytes=" +
        output.length
    );

    return output;
}

